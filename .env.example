# Prefer WEBCAL_URL_FILE with a mounted secret.
WEBCAL_URL_FILE=/run/secrets/webcal_url

# Optional display name. If omitted, X-WR-CALNAME from the feed is used when available.
WEBCAL_NAME=

# Set to absence for Clockodo absence feeds. This enables find_next_clear_weekday.
WEBCAL_PURPOSE=absence

WEBCAL_DEFAULT_TZ=Europe/Berlin
WEBCAL_CACHE_TTL_SECONDS=300
WEBCAL_FETCH_TIMEOUT_MS=15000
WEBCAL_MAX_BYTES=5242880
WEBCAL_MAX_RANGE_DAYS=730
PORT=8000
